{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metalfitness:events:asistencia.registrada:v1",
  "title": "Asistencia registrada por ingreso DNI",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "asistencia.registrada"},
    "event_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "booking-service"},
    "correlation_id": {"type": "string"},
    "traceparent": {"type": "string"},
    "data": {
      "type": "object",
      "required": ["asistencia_id", "reserva_id", "clase_id", "alumno_id", "puntos", "resultado", "origen"],
      "properties": {
        "asistencia_id": {"type": "string", "format": "uuid"},
        "reserva_id": {"type": "string", "format": "uuid"},
        "clase_id": {"type": "string", "format": "uuid"},
        "alumno_id": {"type": "string", "format": "uuid"},
        "actividad_id": {"type": "string", "format": "uuid"},
        "actividad_nombre": {"type": "string"},
        "clase_inicio": {"type": "string", "format": "date-time"},
        "registrada_en": {"type": "string", "format": "date-time"},
        "resultado": {"const": "ASISTIO"},
        "origen": {"const": "INGRESO_DNI"},
        "puntos": {"const": 500}
      }
    }
  }
}
