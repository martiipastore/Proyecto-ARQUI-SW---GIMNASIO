# Variables de entorno del stack local (docker compose).
# Uso: cp .env.example .env   (el archivo .env está en .gitignore; nunca lo commitees)
# Los valores de abajo son SOLO para desarrollo local. En cualquier otro entorno, cambialos todos.

# --- General -------------------------------------------------------------------
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
HEALTH_CHECK_TIMEOUT=2s

# --- PostgreSQL (una instancia, una base y un usuario por servicio) --------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-postgres-change-me
MEMBERS_DB_PASSWORD=dev-members-change-me
BOOKING_DB_PASSWORD=dev-booking-change-me
BENEFITS_DB_PASSWORD=dev-benefits-change-me

# --- MongoDB (training_db y notifications_db, un usuario por base) --------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=dev-mongo-change-me
TRAINING_DB_PASSWORD=dev-training-change-me
NOTIFICATIONS_DB_PASSWORD=dev-notifications-change-me

# --- Redis ----------------------------------------------------------------------
REDIS_PASSWORD=dev-redis-change-me

# --- RabbitMQ -------------------------------------------------------------------
RABBITMQ_USER=gym
RABBITMQ_PASSWORD=dev-rabbit-change-me

# --- api-gateway ----------------------------------------------------------------
# Timeout por defecto de cada ruta y overrides por ruta (GATEWAY_TIMEOUT_<RUTA>).
# Rutas: AUTH, USERS, MEMBERSHIPS, ACTIVITIES, CLASSES, BOOKINGS, CHECK_INS,
#        BENEFITS, TRAINING, NUTRITION, PARTNER_API
GATEWAY_TIMEOUT_DEFAULT=3s
GATEWAY_TIMEOUT_BOOKINGS=5s
GATEWAY_TIMEOUT_PARTNER_API=5s
GATEWAY_STATUS_TIMEOUT=2s
# Orígenes que pueden llamar al gateway desde el navegador (separados por coma).
GATEWAY_CORS_ORIGINS=http://localhost:5173

# --- web ------------------------------------------------------------------------
# URL del gateway vista desde el navegador (se incrusta al construir el frontend).
VITE_API_URL=http://localhost:8080

# --- Identidad y registro externo (activar ambos servicios juntos) -------------
MEMBERS_IDENTITY_ENABLED=false
MEMBERS_BACKGROUND_WORKER_ENABLED=true
MEMBERS_WORKER_INTERVAL=2s
BENEFITS_EXTERNAL_REGISTRATION_ENABLED=false
# Secretos aleatorios distintos de al menos 32 caracteres; completar fuera de Git.
GYM_INTERNAL_SERVICE_KEY=
MEMBERS_ACTIVATION_ENCRYPTION_KEY=
# RSA PEM (>=2048 bits), par generado fuera del repositorio. Se admite \n literal.
# Clave PRIVADA solo en Members; el gateway recibe únicamente la pública.
MEMBERS_JWT_PRIVATE_KEY=
GATEWAY_JWT_PUBLIC_KEY=
MEMBERS_PUBLIC_URL=http://localhost:5173
MEMBERS_SMTP_HOST=mailpit
MEMBERS_SMTP_PORT=1025
MEMBERS_SMTP_FROM=gimnasio@gym.local
MEMBERS_SMTP_USER=
MEMBERS_SMTP_PASSWORD=
# true exclusivamente para Mailpit local sin credenciales; producción exige TLS.
MEMBERS_SMTP_ALLOW_PLAINTEXT=false
